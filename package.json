{
  "name": "eidolon",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "doctor": "bun scripts/doctor.ts",
    "doctor:check": "bun scripts/doctor.ts --check",
    "dev:conductor": "bunx kill-port 3000 && bun --cwd apps/conductor dev",
    "dev:canvas": "bunx kill-port 8081 && bun --cwd apps/canvas dev",
    "dev:canvas:web": "bunx kill-port 8081 && bun --cwd apps/canvas dev:web",
    "dev:canvas:go": "bunx kill-port 8081 && bun --cwd apps/canvas dev:go",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:apk": "bun --cwd apps/canvas build:apk",
    "release": "bun scripts/release.ts",
    "release:dry": "bun scripts/release.ts --dry-run",
    "storage:up": "docker compose -f docker-compose.dev.yml up -d --wait && bun scripts/storage-env.ts",
    "storage:down": "docker compose -f docker-compose.dev.yml down",
    "storage:reset": "docker compose -f docker-compose.dev.yml down -v",
    "storage:logs": "docker compose -f docker-compose.dev.yml logs -f storage",
    "docker:build": "docker build -f apps/conductor/Dockerfile -t eidolon-conductor:local .",
    "check:size": "bun scripts/check-file-size.ts",
    "check:size:all": "bun scripts/check-file-size.ts --all"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "^1.4.1",
    "turbo": "latest",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "lightningcss": "1.29.2",
    "react-native-worklets": "0.10.1"
  },
  "overrides": {
    "lightningcss": "1.29.2",
    "react-native-worklets": "0.10.1"
  }
}
