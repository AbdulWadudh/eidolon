# Google Fonts Developer API key, used by the "Browse Google Fonts" picker.
# Create one at https://console.cloud.google.com/ and enable the
# "Web Fonts Developer API". EXPO_PUBLIC_* vars are inlined into the JS bundle
# at build time, so treat this key as public and restrict it by API + referrer.
EXPO_PUBLIC_GOOGLE_FONTS_API_KEY=

# The conductor this build should talk to, prefilled into the pairing form.
# Include the scheme for a deployed host so the socket uses wss:
#   EXPO_PUBLIC_CONDUCTOR_HOST=https://3000.k79.quest
# A bare authority stays plain http/ws, which is what you want on a LAN:
#   EXPO_PUBLIC_CONDUCTOR_HOST=192.168.1.39:3000
# Leave it empty and the field starts blank.
EXPO_PUBLIC_CONDUCTOR_HOST=
