{
  "name": "@eidolon/canvas",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:web": "expo start --web",
    "dev:go": "expo start --go",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "expo prebuild --platform android --no-install && cd android && ./gradlew.bat app:assembleRelease -x lint -x test",
    "build:apk:dev": "expo run:android",
    "build:aab": "expo prebuild --platform android --no-install && cd android && ./gradlew.bat app:bundleRelease -x lint -x test"
  },
  "dependencies": {
    "@eidolon/protocol": "workspace:*",
    "@eidolon/tokens": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.0",
