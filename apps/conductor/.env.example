PORT=3000
HOST="0.0.0.0"
# Signs sessions and password hashes. Set it once and keep it: changing it
# signs every account out. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# The address phones should sign in against. Set this whenever the conductor is
# reachable on a domain rather than the LAN. Unset means "use the LAN address".
PUBLIC_URL=""

# Which model family is on 8080 and which image stack ComfyUI is driven with.
# Both are switches, not rewrites: see packages/config/src/llm.ts and image.ts
# for what each one carries. LLM_PROFILE must match what stack/start-llm.bat
# actually launched.
#   LLM_PROFILE:   qwen35 | llama3
#   IMAGE_PRESET:  sdxlPulid | sd15FaceId
LLM_PROFILE="qwen35"
IMAGE_PRESET="sdxlPulid"
LLM_API_URL="http://127.0.0.1:8080/v1"
LLM_MODEL="eidolon-llm"
COMFYUI_URL="http://127.0.0.1:8188"
# Recall runs off a purpose-built embedder (stack/start-embed.bat), not the
# chat model: --embeddings forces llama-server's n_batch down to 512 and
# prefill drops with it.
EMBEDDINGS_API_URL="http://127.0.0.1:8082/v1"
EMBEDDINGS_MODEL="eidolon-embed"

# Kokoro-FastAPI, for the voice she speaks in.
TTS_API_URL="http://127.0.0.1:8880/v1"

# Optional. An OpenAI-compatible transcription node (faster-whisper-server,
# whisper.cpp server) so a call can hear you on a device with no speech
# recognition of its own. Unset means the app falls back to on-device only.
STT_API_URL=""

# Web Search Configuration
# Primary uses duck-duck-scrape (no key needed).
# Optional Fallback Keys:
SERPER_API_KEY=""
EXA_API_KEY=""

S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="eidolon-media"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_PUBLIC_URL="https://s3.example.com/eidolon-media"
S3_FORCE_PATH_STYLE="true"
MOCK_BACKDROP_URL=""
