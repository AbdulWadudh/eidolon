PORT=3000
HOST="0.0.0.0"
PAIRING_SECRET="eidolon_dev_secret_key_change_in_prod"

# Local inference and generation backends.
LLM_API_URL="http://127.0.0.1:5000/v1"
LLM_MODEL="Sao10K/L3-8B-Stheno-v3.2"
COMFYUI_URL="http://127.0.0.1:8188"

# SearXNG instance used for web lookups. Leave empty to disable search.
SEARXNG_URL="https://searx.example.com"

# SQLite and LanceDB live outside the repository, under %LOCALAPPDATA%\eidolon\data
# on Windows and ~/.eidolon/data elsewhere. There is no path to configure here:
# see apps/conductor/src/utils/paths.ts.

# S3-compatible object storage for character images and voice notes.
# Works with any implementation - MinIO, a self-hosted gateway, or AWS S3.
# S3_PUBLIC_URL is the base the mobile app streams from; it defaults to
# "<S3_ENDPOINT>/<S3_BUCKET>" and only needs setting behind a CDN or custom domain.
# S3_FORCE_PATH_STYLE must be "true" unless the host has per-bucket DNS.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="eidolon-media"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_PUBLIC_URL="https://s3.example.com/eidolon-media"
S3_FORCE_PATH_STYLE="true"
