PORT=3000
HOST="0.0.0.0"
PAIRING_SECRET=""

# The address phones should pair against. Set this whenever the conductor is
# reachable on a domain rather than the LAN, or the QR advertises an unroutable
# local IP. Unset means "advertise the LAN address".
PUBLIC_URL=""

LLM_API_URL="http://127.0.0.1:5000/v1"
LLM_MODEL="Sao10K/L3-8B-Stheno-v3.2"
COMFYUI_URL="http://127.0.0.1:8188"

# Web Search Configuration
# Primary uses duck-duck-scrape (no key needed).
# Optional Fallback Keys:
SERPER_API_KEY=""
EXA_API_KEY=""

S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="eidolon-media"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_PUBLIC_URL="https://s3.example.com/eidolon-media"
S3_FORCE_PATH_STYLE="true"
MOCK_BACKDROP_URL=""
